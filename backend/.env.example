# Copy this file to backend/.env and fill in only the providers you intend to use.
# API keys must never be added to source code or data/settings/ai_settings.json.

CAREERMATE_AI_PROVIDER=ollama

# Local Ollama
CAREERMATE_OLLAMA_HOST=http://127.0.0.1:11434
CAREERMATE_OLLAMA_MODEL=gemma4:e4b

# OpenAI API (billed separately from any ChatGPT subscription)
OPENAI_API_KEY=
CAREERMATE_OPENAI_MODEL=

# Optional OpenAI-compatible API (for providers that document compatibility)
CAREERMATE_OPENAI_COMPATIBLE_API_KEY=
CAREERMATE_OPENAI_COMPATIBLE_BASE_URL=
CAREERMATE_OPENAI_COMPATIBLE_MODEL=
